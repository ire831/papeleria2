/* =========================
   RESET
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

/* =========================
   BODY
========================= */

body{
    font-family:'Poppins', sans-serif;
    background:linear-gradient(135deg,#f5f7fa,#dfe9f3);
    color:#333;
    line-height:1.6;
}

/* =========================
   HEADER
========================= */

header{
    background:linear-gradient(90deg,#1e3c72,#2a5298);
    color:white;
    padding:25px 0;
    box-shadow:0 4px 15px rgba(0,0,0,0.2);
    position:sticky;
    top:0;
    z-index:1000;
}

/* =========================
   LOGO
========================= */

.logo{
    text-align:center;
}

.logo h1{
    font-size:3rem;
    font-weight:700;
}

.logo p{
    margin-top:8px;
    font-size:1.1rem;
    opacity:0.9;
}

/* =========================
   MENU
========================= */

nav{
    margin-top:20px;
}

.menu{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:20px;
    list-style:none;
    flex-wrap:wrap;
}

.menu li a{
    color:white;
    text-decoration:none;
    font-weight:600;
    padding:12px 20px;
    border-radius:10px;
    transition:0.3s;
}

/* Hover del menú */

.menu li a:hover{
    background:white;
    color:#1e3c72;
    transform:translateY(-2px);
}

/* Link activo */

.menu li a.active{
    background:white;
    color:#1e3c72;
}

/* =========================
   MAIN
========================= */

main{
    max-width:1200px;
    margin:50px auto;
    padding:20px;
}

/* =========================
   HERO
========================= */

.hero{
    text-align:center;
    margin-bottom:50px;
}

.hero h2{
    font-size:2.7rem;
    color:#1e3c72;
    margin-bottom:15px;
}

.hero p{
    font-size:1.1rem;
    color:#555;
}

/* =========================
   TARJETAS
========================= */

.container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:30px;
}

.card{
    background:white;
    padding:30px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,0.1);
    transition:0.4s;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 15px 35px rgba(0,0,0,0.15);
}

.card h3{
    color:#1e3c72;
    margin-bottom:20px;
    font-size:1.5rem;
}

.card p{
    margin-bottom:10px;
}

/* =========================
   LISTAS
========================= */

.card ul{
    margin-left:20px;
}

.card ul li{
    margin-bottom:10px;
}

/* =========================
   GRID MATERIALES
========================= */

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:25px;
}

.item{
    background:white;
    border-radius:20px;
    padding:30px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,0.1);
    transition:0.3s;
}

.item:hover{
    transform:scale(1.05);
}

.item .icon{
    font-size:55px;
    margin-bottom:15px;
}

.item h3{
    color:#1e3c72;
}

/* =========================
   MAPA
========================= */

iframe{
    width:100%;
    height:450px;
    border:none;
    border-radius:20px;
    margin-top:20px;
    box-shadow:0 5px 20px rgba(0,0,0,0.1);
}

/* =========================
   BOTONES
========================= */

.btn{
    display:inline-block;
    background:#1e3c72;
    color:white;
    text-decoration:none;
    padding:12px 25px;
    border-radius:10px;
    margin-top:15px;
    transition:0.3s;
}

.btn:hover{
    background:#2a5298;
    transform:translateY(-2px);
}

/* =========================
   FOOTER
========================= */

footer{
    background:#1e3c72;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:60px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:768px){

    .logo h1{
        font-size:2.2rem;
    }

    .hero h2{
        font-size:2rem;
    }

    .menu{
        flex-direction:column;
        gap:10px;
    }

    main{
        margin:30px auto;
    }
}
